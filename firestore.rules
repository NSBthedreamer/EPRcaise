rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    match /users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false; // ajout des administrateurs depuis la console Firebase
    }
    match /loans/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.status in ['attente_garant','attente_decision'];
      allow update: if isAdmin()
        || (signedIn() && resource.data.garantId == request.auth.uid && resource.data.status == 'attente_garant'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sigGarant','status','garantSignedAt']));
    }
  }
}
